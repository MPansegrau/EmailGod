# Postgres
POSTGRES_USER=itc
POSTGRES_PASSWORD=itc
POSTGRES_DB=itc
DATABASE_URL=postgresql+psycopg://itc:itc@db:5432/itc

# Redis
REDIS_URL=redis://redis:6379/0

# S3
AWS_REGION=us-west-1
AWS_S3_BUCKET=peninsulators-itc-dev
AWS_ACCESS_KEY_ID=YOURKEY
AWS_SECRET_ACCESS_KEY=YOURSECRET

# Trello
TRELLO_KEY=your_trello_key
TRELLO_TOKEN=your_trello_token

# BuildingConnected (placeholder token/keys as needed)
BC_API_KEY=your_bc_key

# Zoom Chat App
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_VERIFICATION_TOKEN=verify_token

# App
ALLOWLIST_INBOXES=mpansegrau@peninsulators.com,bids@peninsulators.com,contracts@peninsulators.com
DEEP_EMAIL_CAP=200
MAX_ATTACHMENT_MB=200
TIMEZONE=America/Los_Angeles
